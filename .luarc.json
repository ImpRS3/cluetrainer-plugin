{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"workspace.ignoreDir": [
		"dependencies/dynamic/"
	],
	"workspace.library": [
		"dependencies/runescape-api-stubs/types.lua",
		"dependencies/runescape-api-stubs/generated/",
		//"dependencies/runescape-api-stubs/consts/"
		"dependencies/zyklib/src/",
		"dependencies/prettyui/"
	],
  "Lua.workspace.diagnostics.workspaceDelay": 0,
  "Lua.diagnostics.workspaceEvent": "OnSave",
  "Lua.diagnostics.neededFileStatus": {},
	"workspace.checkThirdParty": false,
	"runtime.version": "Lua 5.4",
	"runtime.builtin": {
		"basic": "enable",
		"table": "enable",
		"string": "enable",
		"math": "enable",
		"io": "enable",
		"os": "disable",
		"package": "enable",
		"debug": "disable"
	},
	"runtime.path": [
		"cluetrainer/?.lua",
		"dependencies/zyklib/src/?.lua",
		"dependencies/prettyui/?.lua",
		"cluetrainer_devtool/?.lua"
	],
	"completion.requireSeparator": "/",
	"diagnostics.disable": [
		"different-requires",
        "lowercase-global"
	],
	"diagnostics.severity": {
		"undefined-field": "Warning",
		"missing-fields": "Warning"
	}
}