{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"workspace.ignoreDir": [
		"dependencies/plugins/"
	],
	"workspace.library": [
		"dependencies/runescape-api-stubs/types.lua",
		"dependencies/runescape-api-stubs/generated/"
		//"dependencies/runescape-api-stubs/consts/"
	],
	"workspace.checkThirdParty": false,
	"runtime.version": "Lua 5.4",
	"runtime.builtin": {
		"basic": "enable",
		"table": "enable",
		"string": "enable",
		"math": "enable",
		"io": "disable",
		"os": "disable",
		"package": "enable",
		"debug": "disable"
	},
	"runtime.path": [
		"cluetrainer/?.lua",
		"cluetrainer/?/init.lua"
	],
	"completion.requireSeparator": "/",
    "diagnostics.disable": [
        "different-requires"
    ]
}